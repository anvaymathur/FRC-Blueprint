package frc.robot.subsystems.<%= name.toLowerCase()%>;

import static edu.wpi.first.units.Units.*;

import edu.wpi.first.math.MathUtil;
import edu.wpi.first.math.controller.PIDController;
import edu.wpi.first.math.system.plant.DCMotor;
import edu.wpi.first.math.system.plant.LinearSystemId;
import edu.wpi.first.units.measure.AngularVelocity;
import edu.wpi.first.wpilibj.simulation.FlywheelSim;
import edu.wpi.first.wpilibj.simulation.RoboRioSim;

public class <%= name.charAt(0).toUpperCase() + name.slice(1) %>IOSim implements <%= name.charAt(0).toUpperCase() + name.slice(1) %>IO{
    private final FlywheelSim   flywheel;
    private final PIDController pidController;
    private boolean isRunning;

    public <%= name.charAt(0).toUpperCase() + name.slice(1) %>IOSim() {

        flywheel = new FlywheelSim(
                LinearSystemId.createFlywheelSystem(
                        DCMotor.getKrakenX60(<%= 1 + numFollowers %>),
                        <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.FLYWHEEL_INERTIA,
                        <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SENSOR_TO_MECHANISM_GEAR_RATIO
                ),
                DCMotor.getKrakenX60(<%= 1 + numFollowers %>)
            );

        flywheel.update(0.02);

        pidController = new PIDController(
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.SIM_PID_CONSTANTS.kP, 
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.SIM_PID_CONSTANTS.kI, 
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.SIM_PID_CONSTANTS.kD
        );
        isRunning = true;
    }
    
    @Override
    public void setVoltage(double volts){
        flywheel.setInputVoltage(volts);
    }

    @Override
        public void stopMotor() {
            flywheel.setInputVoltage(0.0);
            flywheel.setAngularVelocity(0);
            pidController.reset();
            isRunning = false;
        }

    @Override
    public AngularVelocity getVelocity() {
        return flywheel.getAngularVelocity();
    }

    @Override
    public void setSetpoint(AngularVelocity setpoint, int slot) {
        pidController.setSetpoint(setpoint.in(RadiansPerSecond));
    }

    @Override
    public void updateInputs(<%= name.charAt(0).toUpperCase() + name.slice(1) %>Inputs inputs) {

        double volts = 0.0;
        double current = 0.0;
        if (isRunning) {
            volts = MathUtil.clamp(
                    pidController.calculate(flywheel.getAngularVelocityRadPerSec()) * 12,
                    -RoboRioSim.getVInVoltage(),
                    RoboRioSim.getVInVoltage()
            );
            current = flywheel.getCurrentDrawAmps();
        }

        flywheel.setInputVoltage(volts);

        inputs.is<%= name.charAt(0).toUpperCase() + name.slice(1) %>Connected = true;
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>Temperature = 0.0;
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>Voltage = Volts.of(volts);
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>SupplyCurrent = Amps.of(current);
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>Velocity = flywheel.getAngularVelocity();
    }

    
}