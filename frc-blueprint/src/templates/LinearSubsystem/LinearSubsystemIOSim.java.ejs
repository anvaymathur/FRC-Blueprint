package frc.robot.subsystems.<%= name.charAt(0).toLowerCase() + name.slice(1) %>;

import static edu.wpi.first.units.Units.*;

import edu.wpi.first.math.MathUtil;
import edu.wpi.first.math.controller.PIDController;
import edu.wpi.first.math.system.plant.DCMotor;
import edu.wpi.first.units.measure.Distance;
import edu.wpi.first.wpilibj.simulation.ElevatorSim;
import edu.wpi.first.wpilibj.simulation.RoboRioSim;

public class <%= name.charAt(0).toUpperCase() + name.slice(1) %>IOSim implements <%= name.charAt(0).toUpperCase() + name.slice(1) %>IO {
    private final ElevatorSim   <%= name.charAt(0).toLowerCase() + name.slice(1) %>;
    private final PIDController pidController;

    private boolean running;

    public <%= name.charAt(0).toUpperCase() + name.slice(1) %>IOSim() {
        <%= name.charAt(0).toLowerCase() + name.slice(1) %> = new ElevatorSim(
            DCMotor.getKrakenX44(<%= 1 + numFollowers %>),
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SENSOR_TO_MECHANISM_GEAR_RATIO,
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.MASS.in(Kilograms),
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.DRUM_RADIUS.in(Meters),
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.MIN_DISTANCE.in(Meters),
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.MAX_DISTANCE.in(Meters),
            true,
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.MIN_DISTANCE.in(Meters)
        );

        pidController = new PIDController(
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.SIM_PID_CONSTANTS.kP, 
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.SIM_PID_CONSTANTS.kI, 
            <%= name.charAt(0).toUpperCase() + name.slice(1) %>Constants.SimConstants.SIM_PID_CONSTANTS.kD
        );

        running = false;
    }

    /**
     * set motor to assigned voltage
     *
     * @param volts assigned voltage
     */
    @Override
    public void setVoltage(double volts) {
        <%= name.charAt(0).toLowerCase() + name.slice(1) %>.setInputVoltage(volts);
    }

    /**
     * Stop the motor
     */
    @Override
    public void stopMotor() {
        running = false;
        setVoltage(0);
    }

    /**
     * Zero the encoder values
     */
    @Override
    public void zeroEncoder() {
        <%= name.charAt(0).toLowerCase() + name.slice(1) %>.setState(0, 0);
    }

    /**
     * return encoder values
     *
     * @return encoder values
     */
    @Override
    public Distance getPosition() {
        return Meters.of(<%= name.charAt(0).toLowerCase() + name.slice(1) %>.getPositionMeters());
    }

    /**
     * set motor position to assigned setpoint using pid constants
     *
     * @param setpoint setpoint value
     * @param slot pid constants slot (irrelevant for sim)
     */
    @Override
    public void setSetpoint(Distance setpoint, int slot) {
        pidController.setSetpoint(setpoint.in(Meters));
    }

    @Override
    public void updateInputs(<%= name.charAt(0).toUpperCase() + name.slice(1) %>Inputs inputs){
        double volts = 0.0;
        double current = 0.0;
        if (running) {
            volts = MathUtil.clamp(
                    pidController.calculate(<%= name.charAt(0).toLowerCase() + name.slice(1) %>.getPositionMeters()) * 12,
                    -RoboRioSim.getVInVoltage(),
                    RoboRioSim.getVInVoltage()
            );
            current = <%= name.charAt(0).toLowerCase() + name.slice(1) %>.getCurrentDrawAmps();
        }
        <%= name.charAt(0).toLowerCase() + name.slice(1) %>.setInputVoltage(volts);
        <%= name.charAt(0).toLowerCase() + name.slice(1) %>.update(0.02);

        inputs.is<%= name.charAt(0).toUpperCase() + name.slice(1) %>Connected = true;
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>Voltage = Volts.of(volts);
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>Position = Meters.of(<%= name.charAt(0).toLowerCase() + name.slice(1) %>.getPositionMeters());
        inputs.<%= name.charAt(0).toLowerCase() + name.slice(1) %>SupplyCurrent = Amps.of(current);

    }    
}