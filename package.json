{
  "name": "frc-blueprint",
  "displayName": "FRC Blueprint",
  "description": "FRC Blueprint is an interactive VS Code extension for generating basic WPILib subsystems with an IO structure",
  "version": "26.1.2",
  "publisher": "anvay-mathur",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvaymathur/FRC-Blueprint"
  },
  "icon": "images/first-logo-padded-680x454.png",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "frc-blueprint.createSubsystem",
        "title": "FRC: Create New Subsystem"
      }
    ],
    "configuration": {
      "title": "FRC Blueprint",
      "properties": {
        "frc-blueprint.subsystemsPath": {
          "type": "string",
          "default": "",
          "description": "The saved path to your FRC subsystems folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.102.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "ejs": "^5.0.2"
  }
}
